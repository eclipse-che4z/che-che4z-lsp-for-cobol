    "number-constant": {
      "match": "(?<![\\+\\-\\w])(\\+|\\-)?\\d+(\\.\\d+)?([Ee](\\-|\\+)\\d+)?(?![\\-\\w])",
      "name": "constant.numeric.integer"
    },
    "string-quoted-constant": {
      "begin": "'",
      "end": "'|$",
      "name": "string.quoted.single.cics"
    },
    "string-double-quoted-constant": {
      "begin": "\"",
      "end": "\"|$",
      "name": "string.quoted.double.cics"
    },
    "comment-cics-source": {
      "match": "^(.{6})(\\/.*|\\*.*)$",
      "captures": {
        "1": {
          "name": "constant.numeric.integer"
        },
        "2": {
          "name": "comment.line.cics.fixed"
        }
      }
    },
    "sequence-number-area": {
      "match": "^.{6}",
      "name": "constant.numeric.integer"
