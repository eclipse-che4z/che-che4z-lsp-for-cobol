{
  "name": "cobol-language-support-for-sample-dialect",
  "displayName": "COBOL Language Support for SAMPLE Dialect",
  "description": "SAMPLE Dialect Support With Basic Functionality",
  "author": "Broadcom",
  "license": "EPL-2.0",
  "version": "0.0.1-TEMPLATE",
  "preview": false,
  "publisher": "BroadcomMFD",
  "keywords": [
    "ibm",
    "cobol",
    "mainframe",
    "zowe",
    "lsp",
    "zos",
    "z/os"
  ],
  "icon": "resources/logo.png",
  "engines": {
    "vscode": "^1.74.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/eclipse/che-che4z-lsp-for-cobol.git"
  },
  "bugs": {
    "url": "https://github.com/eclipse/che-che4z-lsp-for-cobol/issues"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:cobol"
  ],
  "main": "./dist/extension.js",
  "browser": "./dist/extension.js",
  "contributes": {
    "commands": [],
    "grammars": [
      {
        "injectTo": [
          "source.cobol"
        ],
        "scopeName": "sample.injection",
        "path": "./syntaxes/sample.injection.json"
      }
    ],
    "configuration": {
      "title": "COBOL Language Support for SAMPLE Dialect"
    }
  },
  "scripts": {
    "open-in-browser": "vscode-test-web --extensionDevelopmentPath=. .",
    "vscode:prepublish": "npm run build",
    "build": "esbuild src/extension.ts --bundle --sourcemap --target=node16.17.1,chrome108 --outdir=dist --external:vscode --format=cjs",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "pretty": "prettier -w .",
    "lint": "prettier -c . && eslint src --ext ts",
    "test": "node ./out/test/runTest.js",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@vscode/test-web": "*",
    "@types/mocha": "^10.0.1",
    "@types/node": "16.x",
    "@types/vscode": "1.74.0",
    "@typescript-eslint/eslint-plugin": "^5.45.0",
    "@typescript-eslint/parser": "^5.45.0",
    "@vscode/test-electron": "^2.2.0",
    "@vscode/vsce": "2.19.0",
    "esbuild": "^0.17.19",
    "eslint": "^8.28.0",
    "eslint-plugin-sonarjs": "^0.15.0",
    "glob": "^8.0.3",
    "mocha": "^10.1.0",
    "prettier": "2.8.7",
    "ts-jest": "^29.0.1",
    "tslint": "^5.18.0",
    "typescript": "5.0.4"
  },
  "extensionDependencies": [
    "BroadcomMFD.cobol-language-support"
  ],
  "dependencies": {
    "@code4z/cobol-dialect-api": "file:../cobol-dialect-api"
  }
}
