{
  "name": "cobol-language-support-for-daco",
  "displayName": "COBOL Language Support for DaCo",
  "description": "Autocomplete, highlighting and diagnostics for DaCo COBOL code and copybooks",
  "author": "Broadcom",
  "license": "EPL-2.0",
  "version": "1.0.7",
  "preview": false,
  "publisher": "BroadcomMFD",
  "keywords": [
    "DaCo",
    "cobol",
    "mainframe",
    "zowe"
  ],
  "icon": "resources/logo.png",
  "engines": {
    "vscode": "^1.74.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/eclipse/che-che4z-lsp-for-cobol.git"
  },
  "bugs": {
    "url": "https://github.com/eclipse/che-che4z-lsp-for-cobol/issues"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:cobol"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [],
    "grammars": [
      {
        "injectTo": [
          "source.cobol"
        ],
        "scopeName": "daco.injection",
        "path": "./syntaxes/daco.injection.json"
      }
    ],
    "configuration": {
      "title": "COBOL Language Support for DaCo",
      "properties": {
        "cobol-lsp.cpy-manager.daco.paths-local": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Default list of local paths to search for MAID copybooks",
          "uniqueItems": true
        },
        "cobol-lsp.cpy-manager.daco.paths-dsn": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Default list of datasets to search for MAID copybooks\nZowe Explorer version 1.15.0 or higher is required to download copybooks from the mainframe",
          "uniqueItems": true
        },
        "cobol-lsp.cpy-manager.daco.paths-uss": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Default list of USS paths to search for MAID copybooks\nZowe Explorer version 1.15.0 or higher is required to download copybooks from the mainframe",
          "uniqueItems": true
        },
        "cobol-lsp.daco.predefined-sections": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "List of predefined sections",
          "default": [
            "S930",
            "S940",
            "S950",
            "S990",
            "S991",
            "S997",
            "S999"
          ],
          "uniqueItems": true
        },
        "dialect.api.version": {
          "type": "string",
          "default": "legacy",
          "enum": [
            "legacy",
            "new"
          ],
          "description": "Internal setting. Controls Dialect API implementation version.",
          "tags": [
            "internal"
          ]
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "npm run compile && esbuild src/extension.ts --bundle --sourcemap --target=node16.17.1,chrome108 --outdir=dist --external:vscode --format=cjs",
    "compile": "npm run grammar && tsc -p ./",
    "grammar": "npm run lexer && npm run parser",
    "lexer": "antlr-ng -Dlanguage=TypeScript -l -o src/generated ./src/antlr/DaCoLexer.g4 && antlr-ng -Dlanguage=TypeScript -l -o src/generated ./src/antlr/CopybookLexer.g4 && antlr-ng -Dlanguage=TypeScript -l -o src/generated ./src/antlr/VariableLexer.g4",
    "parser": "antlr-ng -Dlanguage=TypeScript -v -o src/generated ./src/antlr/DaCoParser.g4 && antlr-ng -Dlanguage=TypeScript -v -o src/generated ./src/antlr/CopybookParser.g4 && antlr-ng -Dlanguage=TypeScript -v -o src/generated ./src/antlr/VariableParser.g4",
    "watch": "tsc -watch -p ./",
    "lint-format": "prettier -c .",
    "lint-quality": "eslint ./src",
    "lint-fix": "eslint --fix ./src && prettier -w .",
    "lint": "npm run lint-format && npm run lint-quality",
    "pretest": "npm run compile",
    "test:unit": "jest src/test/unit",
    "test:integration": "node ./out/test/runTest.js",
    "test": "npm run test:unit && npm run test:integration",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/glob": "^8.0.3",
    "@types/jest": "^29.5.14",
    "@types/mocha": "^10.0.1",
    "@types/node": "16.18.126",
    "@types/vscode": "1.74.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "2.19.0",
    "antlr-ng": "^1.0.10",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.4",
    "eslint-plugin-sonarjs": "^1.0.4",
    "glob": "^8.0.3",
    "jest-jasmine2": "^29.7.0",
    "jest-sonar-reporter": "^2.0.0",
    "mocha": "^10.1.0",
    "prettier": "2.8.7",
    "ts-jest": "^29.4.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.57.2",
    "vscode-uri": "^3.1.0"
  },
  "extensionDependencies": [
    "BroadcomMFD.cobol-language-support",
    "BroadcomMFD.cobol-language-support-for-idms"
  ],
  "dependencies": {
    "@code4z/cobol-dialect-api": "file:../cobol-dialect-api"
  }
}
